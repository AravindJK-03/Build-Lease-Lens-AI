PORT=4000

# Local development with Ollama
AI_PROVIDER=ollama
AI_MODEL=qwen3:4b
AI_BASE_URL=http://127.0.0.1:11434
# Default: 600000 ms (10 minutes); allowed range: 120000-900000 ms.
AI_TIMEOUT_MS=600000

# Claude deployment (choose a model available to your Anthropic account)
# AI_PROVIDER=anthropic
# AI_MODEL=
# ANTHROPIC_API_KEY=
# Vercel Function maxDuration is 300 seconds; set this below that limit.
# AI_TIMEOUT_MS=270000
